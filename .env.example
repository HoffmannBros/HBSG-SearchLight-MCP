# Copy to .env for local development and smoke tests. Never commit .env.
SEARCHLIGHT_API_KEY=sl_your_key_here

# Optional. Leave unset to let the server resolve the organization from /api.
# SEARCHLIGHT_DEFAULT_ORGANIZATION=

# Optional. Where CSV exports are written. Defaults to Documents/SearchLight Reports.
# SEARCHLIGHT_OUTPUT_DIR=./smoke-output

# Optional tuning.
# SEARCHLIGHT_BASE_URL=https://searchlight.digital
# SEARCHLIGHT_CONCURRENCY=4
